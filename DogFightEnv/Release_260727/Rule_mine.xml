<?xml version="1.0"?>
<!--
  ============================================================================
   Rule (my BT)  -  BEM 기반 1v1 Dogfight Behavior Tree
   (논문2 Yang et al. 2024 Fig.3 흐름도 기반, WEZ/재추격 보강판)
  ============================================================================

  [흐름] 상태갱신(+WEZ) -> Superior 판정 -> 3국면 분기 -> 기동(VP) -> 지면충돌보정

  [보강 포인트 - 논문 대비]
   1) Superior 판정에 3-9 라인(AspectAngle) 반영 -> 적 후미 잡으면 OBFM(추격)
   2) HABFM에서 거리 벌어지면(Room 큼) One/Two circle 대신 Pure로 '재추격(re-merge)'
   3) WEZUpdate/DECO_WEZCheck 추가 -> OBFM에서 WEZ 진입 시 사격 위치 유지(Pure)

  [주의] Sequence/Fallback 에 name= 금지(파서 버그). 거리 단위 m 가정.
  ============================================================================
-->
<root main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <Sequence>

      <!-- ===================== 상태 갱신 ===================== -->
      <SelectTarget          BB="{BB}"/>
      <DirectionVectorUpdate BB="{BB}"/>
      <DistanceUpdate        BB="{BB}"/>
      <CheckSight            BB="{BB}"/>
      <AngleOffUpdate        BB="{BB}"/>
      <AspectAngleUpdate     BB="{BB}"/>
      <WEZUpdate             BB="{BB}" ConeDeg="1.0" MinM="152" MaxM="914"/>

      <!-- ============ Superior? 판정 -> 국면 분류 ============ -->
      <BFMDecision BB="{BB}" DetectRange="9260" Cone="30" BehindAA="90" EnergyMargin="1000"/>

      <!-- ================== 3국면 분기 ==================== -->
      <Fallback>

        <!-- 08-04: 국면분류(BFMDecision)와 무관하게 항상 최우선 체크 — 상대가 조준을
             못 잡고 있으면(상대LOS>45) 즉시 반격. 원래 DBFM/HABFM 안에 각각 넣었으나,
             DBFM의 주분류경로(enemyPoint&&!iPoint)는 그 조건 자체가 "상대LOS<=30"을
             전제해서 안에 있으면 논리적으로 거의 발동 못 함 — 국면 분류 이전(최상위)으로
             옮겨서 매틱 항상 평가되게 함.
             08-05: DECO_StuckCheck(3초 지속락 감지 + Lead 강제전환)를 시도했으나 버그
             수정 후에도 v0/v5/v29에서 순손해로 확인돼(v22c만 개선, v0/v5/v29 전부 악화)
             DECO_TargetLOSCheck 단독(순간 wobble 감지)으로 원복. DECO_StuckCheck 노드
             자체는 등록만 남겨두고(MergeReversal과 동일하게 비활성 상태) XML에서 제거. -->
        <!-- 08-05: Lag로 교체 실험 — 실패, 원복. v29/v32 모두 무승부가 급증(0→32/50,
             0→21/30)하고 WEZ가 거의 사라짐(mean 1~2스텝) — Lag(LagDistance=0)가
             "안전한 접근"이 아니라 "사실상 교전회피"로 작동함. Lead가 정답은 아니지만
             Lag는 더 나쁨 — 원복. -->
        <!-- 08-06 실험: 사거리 게이트. 트레이스 실측 결과 사거리(152~914m) 내 시간의
             76.5%를 이 최상위 분기가 점유하는데, Lead는 예측점을 겨냥해 VP가 표적보다
             중앙값 +20도 앞을 가리킨다(losMe 37.5 vs offb 18.1). 채점 원뿔은 표적의
             '현재 위치' 기준 1도라 그 편향이 그대로 조준 실패가 된다(사거리 내 losMe<3도
             0.98%). 득점 가능 구간에서는 Pure(현재위치 조준)로, 그 밖에서만 Lead로
             접근하도록 분리. — yuno 트리도 독립적으로 같은 결론에 도달해 기록해둠. -->
        <!-- 08-06 결과: 위 사거리 게이트는 공식조건에서 무효 — v32 5/24/1→5/25/0(WEZ스텝
             20.1로 완전 동일 = 발동 자체를 안 함), v29 4/26/0→7/22/1(노이즈 범위).
             로컬조건에서 이 분기가 76.5%를 점유하던 것과 달리, 공식조건(정면 근접 시작)
             에서는 상대LOS가 45도 밑이라 분기가 거의 안 걸린다. 원복. -->
        <!-- ❌ 08-09 실험 실패(원복): 이 분기를 OBFM 블록 **아래로** 내려 OBFM을 살려봤다.
             동기는 실측이었다 — 국면이 OBFM인 틱 250개 중 실제 OBFM 블록 실행이 2개(0.8%)뿐,
             나머지 248개를 이 분기가 가로챘다(두 조건이 같은 상황을 가리킨다: OBFM = 내가
             우세 = 적이 나를 안 겨눔 = 상대LOS 큼 = 이 분기 조건).
             결과는 참담했다(30시드/상대, 순이득):
                 v32  24승4패 +0.7143 -> **7승9패 +0.1233**
                 v29  26승4패 +0.8514 -> 8승6패 +0.1910
                 arcE 30승0패 +0.8476 -> 20승0패 +0.2804
                 arcA 16승7패 +0.2428 -> 2승1패 +0.0341 (나머지 27판 무승부)
                 평균 +0.4836 -> **+0.0626** (8분의 1)
             교전이 189초까지 늘어 결판이 안 난다. **`Lead` 단독이 OBFM 블록보다 압도적으로
             낫다.** 주범은 OBFM 안의 `Lag`로 보인다 — 08-05 `Lead->Lag` 교체 실험에서
             이미 "안전한 접근이 아니라 사실상 교전회피"로 확인됐고(무승부 급증, WEZ 소멸)
             지금 교전 189초·무승부 27판이 그 재현이다.
             ➡️ **해석 정정**: OBFM이 굶는 것은 "잠재력이 잠든 것"이 아니라 **트리가 스스로
                나쁜 경로를 우회하고 있는 것**이다. 08-04에 이 분기를 최상위로 올린 것이
                의도치 않게 OBFM을 무력화했고, 그것이 결과적으로 옳았다.
                OBFM 블록을 되살리려 하지 말 것. 손대려면 블록 자체(특히 Lag)를 재설계해야 한다. -->
        <!-- 08-09 시간인식(3차): **실제로 트래픽이 있는 분기**에 건다.
             실측 도달률 — 이 분기 52.1% / DBFM 38.2% / HABFM 9.5% / OBFM 0.2%.
             오늘 시간인식 1·2차는 둘 다 OBFM 안에 걸어서 애초에 실행되지 않았다.

             근거는 원뿔 폭이 아니라 **남은 시간이 위치 투자의 가치를 결정한다**는 것.
             Lead는 예측점을 겨냥해 표적의 **현재 위치보다 앞**을 가리킨다(실측 중앙값 +20도).
             즉 "지금 득점"을 포기하고 "나중 위치"에 투자하는 기동인데, 라운드가 끝나갈수록
             그 투자를 회수할 시간이 없다. 채점은 표적의 **현재 위치** 기준이므로
             후반에는 Pure(현재위치 조준)로 바꿔 지금 긁는 편이 낫다.
             (08-06에 '사거리 게이트'로 같은 취지를 시도했으나 당시엔 헤드온 기하라
              이 분기가 거의 안 걸려 무효였다. 어빔으로 정정된 지금은 52.1%가 걸린다.) -->
        <!-- ✅✅ 08-09 확정: 이 분기의 Lead를 **Pure로 교체**. 전수평가(30시드/상대, 순이득):
                 Lead 항상(기존)   평균 +0.4836  최저 -0.2382(prev)   v32 24승4패
                 t>=150s부터 Pure  평균 +0.5010  최저 -0.1472         v32 24승3패
                 t>=100s부터 Pure  평균 +0.5864  최저 +0.2195         v32 23승1패
                 **항상 Pure**     평균 **+0.7176**  최저 **+0.5090**  **v32 25승 0패**
             전환이 이를수록 좋아졌고 결국 Lead를 아예 안 쓰는 것이 최선이었다.
             v32/arcE/prev 상대 **피격 정확히 0**, arcA는 16승7패 -> **22승1패**(최대 약점이던
             매치업), <1도 조준시간 v32 0.63 -> **2.28s(3.6배)**, arcE 1.95 -> 4.48s.

             [왜] Lead는 예측점을 겨냥해 표적의 **현재 위치보다 +20도 앞**을 가리킨다(실측).
             그런데 채점 원뿔은 표적의 **현재 위치** 기준 1~3도다. 즉 Lead는 구조적으로
             득점을 버리는 기동이었다. "코너를 잘라 위치를 번다"는 이득이 그 손해를
             넘지 못한다.

             [⚠️ 기록] 나는 처음에 "후반엔 위치 투자를 회수할 시간이 없다"는 **시간 논리**로
             접근했다. 결론(Pure로 바꾼다)은 맞았지만 **이유는 틀렸다** — Lead는 시점과
             무관하게 나빴다. 시간 게이트는 군더더기였고, 값을 t150->t100->제거로 밀어보지
             않았다면 그 사실을 못 봤을 것이다. 그럴듯한 논리가 맞는 결론으로 이끌어도
             **끝까지 밀어봐야 진짜 원인이 드러난다.** -->
        <!-- ❌ 08-10 실험 2건 실패(원복): "사거리 밖에서만" 다른 기동으로 접근하기.
             동기는 무득점 판 추적이었다 — arcA 무득점 9판이 "조준은 되는데(전체 ATA 최소
             0.5도) 813m 밖, 밴드 체류 1.2초"인 꼬리물기 교착이었다. Pure는 상대의 현재
             위치를 겨눠 같은 반경을 따라 돌므로 거리가 안 줄어든다. 914m 밖은 어차피
             득점이 0이니 거기서만 다른 기동을 쓰면 대가가 없으리라 봤다.
             결과(승점, 무득점 판):
                 항상 Pure(현행)      **139.5**,  19판
                 914m 밖 Lead          122.0,  36판
                 914m 밖 Lag            86.0, **126판**
             · Lead: 코너를 잘라 거리는 줄지만 **각도가 벌어진 채 사거리에 진입**한다.
               Lead의 문제는 "득점을 버린다"만이 아니라 **교전 진입 자세를 망친다**는 것.
             · Lag: 08-05 결론(“안전한 접근이 아니라 사실상 교전회피”)의 재확인. 밴드 밖에서만
               써도 아예 사거리에 못 들어온다.
             ➡️ **Pure 단독이 최선이고 접근을 위해 다른 기동을 섞는 시도는 전부 역효과다.**
                무득점 판 19개는 VP 선택으로 풀 문제가 아니다.
                (스로틀 적응형도 무득점 판을 전혀 못 줄였다 — Functions.cpp 주석 참고) -->
        <!-- 🆕 08-10: 높고 느리면 고도를 속도로 바꾼다(슬라이스). 방위는 표적 그대로라
             각을 버리지 않고 수직 성분만 에너지로 전환한다.
             근거(`_stalemate_diag.py` 30시드 vs v29): 무득점/득점이 **이분적**이다 —
                 무득점(6) 공세 0.0% / 수세 42.2% / 공세밴드  0.0s
                 득점 (24) 공세53.2% / 수세  0.0% / 공세밴드 11.8s
             중간 지대가 없다 -> 조준/접근이 아니라 위치 싸움 결과다.
             초기조건도 갈리는 것처럼 보였다(무득점 6408m/220.5m/s vs 득점 4306m/251.7m/s)
             ⚠️ 그러나 **정확 순열검정에서 고도 p=0.177 / 속도 p=0.213으로 유의하지 않다.**
             n=6이라 우연으로 흔한 차이다. 가설로만 다룰 것.
             이 노드의 근거는 상관이 아니라 BFM 원칙이다 — 코너속도 미만에서는 가속이
             선회율과 반경을 동시에 개선하므로 높고 느리면 고도를 속도로 바꾸는 게 맞다.
             기존 트리에는 에너지 관리 노드가 하나도 없었다. 효과는 전수평가가 판정한다.
             게이트는 노드 자체에 있다(거리>1000m, 속도<235m/s, 고도>3000m). -->
        <EnergyTurn BB="{BB}" SpeedBelow="235.0" AltAbove="3000.0" DistBeyond="1000.0"
                    DiveSlope="0.5" FloorAlt="2000.0" TargetAboveMax="400.0"/>

        <!-- 🆕 08-10: 사거리 밖에서 표적이 크게 위에 있으면 **급상승을 따라가지 않는다.**
             방위는 표적 그대로 두고 조준점의 상승 성분만 자른다.
             근거(`_match_trace.py`, vs arcV seed0 시계열):
                 t=30  적고도 3791 (dH -1383) 적피치 +70.0   <- 상대가 줌 상승
                 t=40  내고도 3519 내피치+51.7 내속도 192    <- 따라 올라가며 느려짐
                 t=50  내고도 4056 내속도 193 | 적고도 2507 적속도 267
                                                             <- 나는 높고 느리고 상대는 낮고 빠름
             `Pure`가 표적 위치를 조준하므로 상대가 1400m 위에 있으면 조준점이 급상승
             방향이 되고, 우리가 그대로 따라 올라가 최악의 에너지 상태가 된다.
             **arcV는 줌 상승을 미끼로 쓴다.** 상대는 반드시 내려와야 하므로 에너지를
             지키는 편이 낫다 — 우리 트리는 수평 선회전에 잘 튜닝돼 있다(arcA/arcE 30/30).
             아래로는 제한하지 않는다(강하는 에너지를 벌고 바닥은 PreventLandCrash가 지킨다).
             게이트는 노드 자체에 있다(거리>914m, 표적이 300m 넘게 위). -->
        <FlatPursuit BB="{BB}" DistBeyond="914.0" TargetAboveMin="800.0" MaxClimbSlope="0.0" MinClimbSlope="0.9" MinEnergyMargin="2000.0"/>

        <Sequence>
          <DECO_TargetLOSCheck BB="{BB}" UpDown="Greater" InputLOS="45"/>
          <Pure BB="{BB}"/>
        </Sequence>
        <!-- ───────────── DETECTING : 원거리 접근 -> 추격 ───────────── -->
        <Sequence>
          <DECO_BFMCheck BB="{BB}" CheckBFM="DETECTING"/>
          <Pure BB="{BB}"/>
        </Sequence>

        <!-- ───────────── OBFM : 공격(우세) ───────────── -->
        <Sequence>
          <DECO_BFMCheck BB="{BB}" CheckBFM="OBFM"/>
          <Fallback>
            <!-- 적이 내 WEZ 안 -> 사격 위치 유지(Pure) -->
            <Sequence>
              <DECO_WEZCheck BB="{BB}" Side="Target"/>
              <Pure BB="{BB}"/>
            </Sequence>
            <!-- 너무 근접 + 크게 횡단 -> Lag(오버슛 방지) -->
            <Sequence>
              <DECO_DistanceCheck BB="{BB}" UpDown="Less"    Distance="800"/>
              <DECO_LOSCheck      BB="{BB}" UpDown="Greater" InputLOS="40"/>
              <Lag BB="{BB}" LagDistance="0"/>
            </Sequence>
            <!-- WEZ 사거리(<914m) 진입 -> Pure 로 적 현재위치 정확 조준(득점) -->
            <Sequence>
              <DECO_DistanceCheck BB="{BB}" UpDown="Less" Distance="914"/>
              <Pure BB="{BB}"/>
            </Sequence>
            <!-- 접근 구간(사거리~3000m) + 각 우위 -> Lag 로 적 6시에 미끄러져 접근(오버슛 방지) -->
            <Sequence>
              <DECO_DistanceCheck BB="{BB}" UpDown="Less" Distance="3000"/>
              <DECO_LOSCheck      BB="{BB}" UpDown="Less" InputLOS="45"/>
              <Lag BB="{BB}" LagDistance="0"/>
            </Sequence>
            <!-- 그 외 -> Pure 추격(적 6시/ WEZ 로 파고듦) -->
            <Pure BB="{BB}"/>
          </Fallback>
        </Sequence>

        <!-- ───────────── HABFM : 정면(대등) ───────────── -->
        <Sequence>
          <DECO_BFMCheck BB="{BB}" CheckBFM="HABFM"/>
          <Fallback>
            <!-- 중거리 선회전 -> 에너지로 rate/radius 선택 -->
            <Sequence>
              <DECO_DistanceCheck BB="{BB}" UpDown="Greater" Distance="900"/>
              <Fallback>
                <Sequence>
                  <DECO_EnergyCheck BB="{BB}" UpDown="Greater" Margin="0"/>
                  <TwoCircle BB="{BB}"/>
                </Sequence>
                <OneCircle BB="{BB}"/>
              </Fallback>
            </Sequence>
            <!-- ✅ 08-09 채택: 근접 정렬 시 Lead -> **Pure**. 최상위 분기와 같은 이유다 —
                 Lead는 표적의 현재 위치보다 +20도 앞을 겨냥하는데 채점은 현재 위치 기준.
                 전수평가(30시드/상대): 최저 +0.5090 -> **+0.5346**(v29), 평균 +0.7176 -> +0.7200,
                 v32 25승0패 -> **26승0패**, v29 20승5패 -> **21승4패**.
                 arcA/arcE/prev는 **자릿수까지 동일** — 그 매치업에선 이 분기가 안 걸리고
                 v32/v29에서만 발동한다(HABFM 도달률 9.5%라 효과가 국소적).
                 발동한 곳에서 손해 없이 이득만 났으므로 채택. -->
            <Sequence>
              <DECO_LOSCheck BB="{BB}" UpDown="Less" InputLOS="40"/>
              <Pure BB="{BB}"/>
            </Sequence>
            <Scissors BB="{BB}" Freq="2.0"/>
          </Fallback>
        </Sequence>

        <!-- ───────────── DBFM : 방어(열세) ───────────── -->
        <Sequence>
          <DECO_BFMCheck BB="{BB}" CheckBFM="DBFM"/>
          <Fallback>
            <Sequence>
              <DECO_DistanceCheck BB="{BB}" UpDown="Less" Distance="600"/>
              <!-- 08-05 실험: BreakTurn과 같은 AimBlend를 Jinking(근접회피)에도 시도했으나
                   실패 — v29(19/26/5→19/29/2, 무승부가 패배로), v32(12/13/5→11/15/4)
                   둘 다 악화. 근접 저크(jink)는 예측불가성 자체가 방어력이라 조준방향
                   섞기가 오히려 역효과로 추정. AimBlend=0(사실상 미사용)으로 원복,
                   포트/코드는 남겨둠(추후 다른 값으로 재시도 가능). -->
              <Jinking BB="{BB}" Freq="3.0"/>
            </Sequence>
            <!-- 08-05 실험: 순수회피(AimBlend=0)는 my_ata가 절대 안 줄어듦을 반복 확인(v29/v32
                 트레이스) — 회피 방향에 목표방향을 20% 섞어 "회피하되 서서히 조준각도
                 좁혀지도록" 시도. 자기추적 재발 방지를 위해 여전히 래치시점에만 계산. -->
            <!-- 08-05/06 실험: RelatchSeconds=1.5(기본3.0) — v22c의 무손상패배 시드들
                 개별로는 my_ata 수렴이 뚜렷이 개선됐음(seed16: 패배->승리, seed9/12:
                 min_my_ata가 20~28도->0.02~0.36도로 코앞까지 감). 그런데 종합승률은
                 v22c만 소폭개선(75/19/6->80/20/0, 무승부가 승리로)이고 정작 우리 최강
                 상대인 v29(19/26/5->17/33/0)·v32(12/13/5->10/19/1) 둘 다 뚜렷이 악화 —
                 StuckCheck 때와 같은 패턴(약한상대엔 도움, 강한상대엔 역효과). 재래치를
                 빠르게 하면 각 하드턴의 지속시간이 짧아져 G하중/에너지관리 효과가
                 옅어지고, 숙련된 상대(v29/v32)는 그 불안정함을 파고드는 것으로 추정.
                 원복(기본값 3.0 사용, RelatchSeconds 속성 제거) — 포트/코드는 유지. -->
            <!-- 08-06 실험: MINE_DBG_TRACE로 확인한 완전정체 케이스(134초 DBFM 내내
                 Los_Degree 최소 71도)에 대한 대응 — 재래치마다 실제 개선여부(Los_Degree
                 기준)를 보고, 계속 정체면 그 다음 래치부터 블렌드를 점점 올림(최대 0.5).
                 StuckCheck/RelatchSeconds와 달리 "항상 더 공격적으로"가 아니라 "정체가
                 확인된 경우에만" 강도를 올리는 컨텍스트 인지형 접근. -->
            <BreakTurn BB="{BB}" AimBlend="0.2" EscalationStep="0.05" MaxAimBlend="0.5" StuckImproveDeg="5.0"/>
          </Fallback>
        </Sequence>

        <!-- ───────────── 기본값(NONE) ───────────── -->
        <Task_Empty BB="{BB}"/>

      </Fallback>

      <!-- ============ 지면충돌 방지 ============ -->
      <!-- 08-06: 공식 초기고도가 610~9144m 랜덤임이 확인되면서(Q&A 질문98) 기존
           1800/3200은 과도하게 높았음 — 공식조건 40시드에서 시작고도 3200m 미만 11판
           전패(0%), 3200m 이상 29판 20.7%. 이 노드는 소프트존에서 VP를 Up*8000과
           블렌드하고 하드플로어 아래선 통째로 덮어써서 전투기동이 사라진다. 로컬조건
           (고도 8000m 고정)에서는 발동할 일이 없어 대가를 안 치렀을 뿐.
           규정상 추락=즉시 패배라 끄면 안 되고, 노드 기본값(1000/2000) 수준으로 낮춘다.
           최저 시작고도 610m를 감안해 800/1500. -->
      <!-- 08-09: 시간여유(TTG) 기반 개입 추가. 고도 기반 억제는 4전 4패였고
           원인은 고도만으로 위험한 급강하와 안전한 급강하를 구분 못 하는 것.
           실측 추락시드는 1500m에서 강하율 -287m/s(남은 4.2초)인데 같은 1500m라도
           -50m/s면 30초가 남는다. 규정 하한 300m까지 남은 시간이 6.0초 미만일 때만
           고도와 무관하게 최우선 pull-up. 완만한 강하는 건드리지 않는다. -->
      <PreventLandCrash BB="{BB}" FloorHard="800" FloorSoft="1500" TTGSeconds="6.0"/>

    </Sequence>
  </BehaviorTree>

</root>
